# Salesforce — READ-ONLY integration user for the bonus dashboard.
#
# Do NOT reuse the salesforce/ CI repo's deploy credentials (SF_CLIENT_ID /
# SF_CLIENT_SECRET in that repo's GitHub Environments) — those are scoped to a
# metadata-deploy-capable External Client App. This dashboard only ever reads
# data, so it must run under its own Connected App / External Client App with:
#   - OAuth 2.0 Client Credentials flow enabled
#   - a dedicated run-as integration user on a READ-ONLY permission set
#     (Query/Reports API access to Account, MRR_Change__c, CX_Event__c,
#     NPS_Score__c, DoorLoop_Cancelation_Request__c — no CRUD, no metadata scope)
# See README.md "Salesforce connection" section before filling these in.

SF_INSTANCE_URL=https://doorloop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=62.0

# Set to "true" to serve mock metrics instead of calling Salesforce (default
# when the vars above are empty) — lets the dashboard run before the
# read-only integration user exists.
USE_MOCK_DATA=true
